{
  "name": "veyqra",
  "version": "0.1.0",
  "private": true,
  "description": "Veyqra - AI Generation & Training Platform",
  "scripts": {
    "dev": "bash scripts/start-dev.sh",
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "web": "npm --prefix apps/web run dev",
    "api": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "api:windows": "cd apps/api && .venv\\Scripts\\uvicorn.exe app.main:app --reload --host 0.0.0.0 --port 8000",
    "translation:setup": "cd apps/api && .venv/bin/python scripts/install_translation_models.py",
    "lint": "echo \"Coming soon\"",
    "build": "echo \"Coming soon\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only"
}
